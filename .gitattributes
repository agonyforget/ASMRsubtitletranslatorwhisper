# 换行符策略:仓库里统一 LF,Windows 专用脚本检出为 CRLF
* text=auto

# .cmd 必须是 CRLF(cmd.exe 对 LF 支持不可靠),.ps1 也保持 CRLF
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.bat  text eol=crlf

# 代码与文档用 LF
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf

# 二进制(其实都被 .gitignore 挡掉了,这里只是兜底)
*.mkv  binary
*.mp4  binary
*.wav  binary
*.mp3  binary
*.bin  binary
